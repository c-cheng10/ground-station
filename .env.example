# Copy this file to .env (which git ignores) and fill in the values.

# NASA Earthdata user token for the Giovanni API.
# urs.earthdata.nasa.gov -> sign in -> Generate Token. Lasts 60 days.
EARTHDATA_TOKEN=

# Supabase project URL and service-role key, for writing the downloaded data.
# Supabase dashboard -> Project Settings -> API. Never put this key in the website.
SUPABASE_URL=https://vbumlhsonrozcrzcuirm.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
